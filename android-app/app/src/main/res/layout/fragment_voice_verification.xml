<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice Verification"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deepfake Voice AI Detector"
                    android:textColor="@color/trustvoice_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_server_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_safe"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Server Online"
                android:textColor="@color/status_safe"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Intro Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload any recorded voice audio file to detect whether it is an authentic human voice or an AI-generated deepfake clone."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />

        <!-- File Upload Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_upload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeColor="@color/trustvoice_accent"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_upload_audio"
                    android:background="@drawable/bg_circle_blue"
                    android:padding="16dp"
                    app:tint="@color/trustvoice_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Stored Voice Recording"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to browse device audio files (.wav, .mp3, .m4a, .aac, .ogg)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Audio File"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    android:layout_marginTop="14dp"
                    app:backgroundTint="@color/trustvoice_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Selected File & Playback Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_selected_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_blue"
                        android:padding="10dp"
                        android:src="@drawable/ic_audio_file"
                        app:tint="@color/trustvoice_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tv_file_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="recording_sample.wav"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="middle" />

                        <TextView
                            android:id="@+id/tv_file_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="142 KB • Ready for AI verification"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_play_preview"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶ Play"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/trustvoice_primary"
                        android:textColor="@color/trustvoice_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_playback_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audio loaded and ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Verify Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_analyze_audio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Analyze for Deepfake Voice"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/trustvoice_primary"
            android:layout_marginBottom="16dp" />

        <!-- Loading Progress Bar -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/trustvoice_primary" />

            <TextView
                android:id="@+id/tv_loading_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyzing acoustic features with Wav2Vec2 neural model..."
                android:textColor="@color/trustvoice_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- =================== RESULTS SECTION =================== -->
        <LinearLayout
            android:id="@+id/layout_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Verdict Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/card_bg"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_verdict_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CRITICAL RISK"
                            android:textColor="@color/status_suspicious"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_suspicious"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_processing_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.94s latency"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_verdict_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYNTHETIC VOICE DETECTED"
                        android:textColor="@color/status_suspicious"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tv_verdict_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The acoustic spectral patterns match synthetic voice cloning models. Exercise extreme caution."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Risk Score & Metrics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Threat Risk Score"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_risk_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="91.5%"
                            android:textColor="@color/status_suspicious"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Risk Gauge Bar -->
                    <ProgressBar
                        android:id="@+id/prog_risk_bar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="91"
                        android:progressTint="@color/status_suspicious"
                        android:progressBackgroundTint="#E2E8F0"
                        android:layout_marginTop="12dp" />

                    <!-- Detailed Score Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="3">

                        <!-- AI Probability -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI Probability"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_ai_prob"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="91.5%"
                                android:textColor="@color/status_suspicious"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Human Probability -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Human Match"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_real_prob"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8.5%"
                                android:textColor="@color/status_safe"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Confidence -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Confidence"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_confidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="91.5%"
                                android:textColor="@color/trustvoice_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Forensic Diagnostics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acoustic Forensic Breakdown"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_forensic_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Classified as SYNTHETIC (91.5% confidence)\n• Wav2Vec2 Sequence Classification Layer\n• Temperature Scaled Logits"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_disclaimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Analysis powered by fine-tuned Wav2Vec2 neural network."
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Test Another File Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_another"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Verify Another Audio File"
                android:textColor="@color/trustvoice_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:strokeColor="@color/trustvoice_primary"
                android:layout_marginBottom="24dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
