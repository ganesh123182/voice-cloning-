<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_welcome">

    <fragment
        android:id="@+id/nav_welcome"
        android:name="com.voice.shield.FragmentWelcome"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcome_to_onboarding1"
            app:destination="@id/nav_onboarding1" />
    </fragment>

    <fragment
        android:id="@+id/nav_onboarding1"
        android:name="com.voice.shield.FragmentOnboarding1"
        android:label="Stay a Step Ahead"
        tools:layout="@layout/fragment_onboarding1">
        <action
            android:id="@+id/action_onboarding1_to_onboarding2"
            app:destination="@id/nav_onboarding2" />
        <action
            android:id="@+id/action_onboarding1_to_login"
            app:destination="@id/nav_login" />
    </fragment>

    <fragment
        android:id="@+id/nav_onboarding2"
        android:name="com.voice.shield.FragmentOnboarding2"
        android:label="Privacy"
        tools:layout="@layout/fragment_onboarding2">
        <action
            android:id="@+id/action_onboarding2_to_login"
            app:destination="@id/nav_login" />
    </fragment>

    <fragment
        android:id="@+id/nav_login"
        android:name="com.voice.shield.FragmentLogin"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/nav_signup" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_welcome"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_signup"
        android:name="com.voice.shield.FragmentSignup"
        android:label="Create Account"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signup_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_welcome"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.voice.shield.FragmentHome"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_calls"
        android:name="com.voice.shield.FragmentCalls"
        android:label="Calls"
        tools:layout="@layout/fragment_calls" />

    <fragment
        android:id="@+id/nav_contacts"
        android:name="com.voice.shield.FragmentContacts"
        android:label="Contacts"
        tools:layout="@layout/fragment_contacts" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.voice.shield.FragmentSettings"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/nav_login" />
    </fragment>

    <fragment
        android:id="@+id/nav_liveAnalysis"
        android:name="com.voice.shield.FragmentLiveAnalysis"
        android:label="Live Analysis"
        tools:layout="@layout/fragment_live_analysis">
        <action
            android:id="@+id/action_liveAnalysis_to_threatAlert"
            app:destination="@id/nav_threatAlert" />
    </fragment>

    <fragment
        android:id="@+id/nav_threatAlert"
        android:name="com.voice.shield.FragmentThreatAlert"
        android:label="Threat Alert"
        tools:layout="@layout/fragment_threat_alert" />

    <fragment
        android:id="@+id/nav_voiceEnrollment"
        android:name="com.voice.shield.FragmentVoiceEnrollment"
        android:label="Voice Enrollment"
        tools:layout="@layout/fragment_voice_enrollment" />

    <fragment
        android:id="@+id/nav_voiceVerification"
        android:name="com.voice.shield.FragmentVoiceVerification"
        android:label="Voice Verification"
        tools:layout="@layout/fragment_voice_verification" />

</navigation>
