<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ TrustVoice Shield"
                android:textColor="#38BDF8"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI-Powered Live Call Deepfake Defense"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTECTION STATUS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <View
                        android:id="@+id/view_status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#22C55E"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tv_shield_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Call Shield Ready"
                        android:textColor="#F8FAFC"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-activates during phone calls to scan for voice cloning."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Permissions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUIRED PERMISSIONS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_perm_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ ] Microphone (AudioRecord)"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_perm_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ ] Phone State (Call Detection)"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tv_perm_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ ] Display Over Other Apps (HUD)"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btn_grant_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grant All Permissions"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Backend Configuration Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BACKEND WEBSOCKET SERVER"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/et_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0F172A"
                    android:padding="12dp"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:hint="ws://10.0.2.2:8000/api/monitoring/live"
                    android:textColorHint="#475569"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Emulator default: ws://10.0.2.2:8000\n• Real device: ws://YOUR_PC_LAN_IP:8000"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btn_save_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Server URL"
                    android:backgroundTint="#334155"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Live Demo / Test Actions -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEMO AND TESTING TOOLS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <Button
                    android:id="@+id/btn_toggle_live_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Live Call Monitor"
                    android:backgroundTint="#16A34A"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btn_test_hud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test Floating HUD Overlay"
                    android:backgroundTint="#7C3AED"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btn_simulate_scam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simulate Deepfake Scam Alert"
                    android:backgroundTint="#DC2626"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
